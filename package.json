    "test:ball-physics": "node tests/ball-physics.test.cjs",
    "test:press-support": "node tests/press-support.test.cjs",
    "test:pressure-exits": "node tests/pressure-exits.test.cjs",
    "test:keeper-gather": "node tests/keeper-gather.test.cjs",
