    "test:support-continuity": "node tests/support-continuity.test.cjs",
    "test:stage2": "npm run test:stage1 && npm run test:support-continuity",
    "test:preparation": "node tests/pass-preparation.test.cjs",
    "test:match-startup": "node tests/match-startup.test.cjs",
