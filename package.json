    "test:pass-lane-read": "node tests/pass-lane-read.test.cjs",
    "test:pass-review": "node tests/pass-review.test.cjs",
    "test:pass-release-read": "node tests/pass-release-read.test.cjs",
    "test:receiver-forecast": "node tests/receiver-forecast.test.cjs"
